# ==============================================================================
# WORKFLOW PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env for local development. Never commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 17)
# ------------------------------------------------------------------------------
POSTGRES_DB=workflow_platform
POSTGRES_USER=workflow
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Standard JDBC connection parameters used by Spring Boot:
# DATABASE_URL=jdbc:postgresql://localhost:5433/workflow_platform
# DATABASE_USERNAME=workflow
# DATABASE_PASSWORD=replace_with_strong_password_in_production

# HikariCP connection pool settings:
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_VALIDATION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 2. Backend Platform Server Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
COMMAND_TRANSACTION_TIMEOUT_SECONDS=10
SHUTDOWN_TIMEOUT=30s

# HTTP timeouts & limits:
HTTP_CONNECTION_TIMEOUT=20s
HTTP_KEEP_ALIVE_TIMEOUT=15s
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=50MB

# ------------------------------------------------------------------------------
# 3. Security & Secrets
# ------------------------------------------------------------------------------
# CORS allowed origins (comma-separated). Use specific origins in staging/prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Signing secret used to verify webhook / callback HMAC-SHA256 signatures:
CALLBACK_SIGNING_SECRET=replace_with_64_char_hex_secret_in_production

# Object storage local root directory:
PLATFORM_FILES_ROOT=/tmp/workflow-platform-files
MAX_FILE_SIZE_BYTES=26214400

# ------------------------------------------------------------------------------
# 4. Frontend Application (Next.js)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Browser public API endpoint (relative '/api/v1' for same-origin proxy):
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Internal SSR / Server route proxy target to backend container:
BACKEND_INTERNAL_URL=http://localhost:8080
